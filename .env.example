# Application
APP_ENV=production
AZURE_ENVIRONMENT=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Azure identity
# Configure credentials for cloud deployment
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_REGION=
AZURE_USE_MANAGED_IDENTITY=true

# Azure Event Hubs
SQUEEZE_EVENT_HUB_NAMESPACE=squeeze.servicebus.windows.net
SQUEEZE_EVENT_HUB_NAME=squeeze-events
SQUEEZE_EVENT_HUB_CONSUMER_GROUP='$Default'
SQUEEZE_EVENT_HUB_DEAD_LETTER_NAME=squeeze-deadletter
SQUEEZE_EVENT_HUB_CHECKPOINT_STORE=
SQUEEZE_EVENT_HUB_BATCH_SIZE=100
SQUEEZE_EVENT_HUB_RETRY_TOTAL=3

# Dashboard live Event Hubs bridge. Use a dedicated consumer group so the API
# receives every event without competing with the production processor.
SQUEEZE_DASHBOARD_STREAM_ENABLED=false
SQUEEZE_DASHBOARD_CONSUMER_GROUP=squeeze-dashboard
SQUEEZE_DASHBOARD_STARTING_POSITION=@latest

# Microsoft Foundry
FOUNDRY_PROJECT_ENDPOINT=https://example.services.ai.azure.com/api/projects/squeeze
FOUNDRY_AGENT_ID_ANALYST=squeeze-analyst
FOUNDRY_AGENT_ID_EXPLANATION=squeeze-explanation
FOUNDRY_AGENT_ID_VALIDATOR=squeeze-validator
FOUNDRY_AGENT_ID_NARRATIVE=squeeze-narrative

# Agent runtime controls
AGENT_GATEWAY_ENABLED=true
AGENT_FALLBACK_ENABLED=true
AGENT_MAX_CONCURRENCY=4
AGENT_TIMEOUT_SECONDS=10
AGENT_MAX_RETRIES=2
AGENT_COOLDOWN_SECONDS=30
AGENT_TEMPERATURE=0
AGENT_MAX_TOKENS=
ANALYST_ENABLED=true
EXPLANATION_ENABLED=true
VALIDATOR_AGENT_ENABLED=true
NARRATIVE_ENABLED=true
NARRATIVE_BATCH_SECONDS=5
PERSONALIZATION_ENABLED=false

# Observability
AGENT_TRACING_ENABLED=true
AGENT_TRACE_PAYLOADS=false
AGENT_METRICS_ENABLED=true
AGENT_TOKEN_USAGE_ENABLED=true
APPLICATIONINSIGHTS_CONNECTION_STRING=
AZURE_MONITOR_ENABLED=true

# Cloud processing
SNAPSHOT_INTERVAL_EVENTS=50
CLOUD_COST_CONTROLS_ENABLED=true
MAX_AGENT_INVOCATIONS_PER_MATCH=20
MAX_EVENT_RETENTION_DAYS=7
MAX_TRACE_RETENTION_DAYS=7

# Container Apps scaling
PROCESSOR_MIN_REPLICAS=1
PROCESSOR_MAX_REPLICAS=5
EVENTHUB_TARGET_UNPROCESSED_EVENTS=100
KEDA_POLLING_INTERVAL_SECONDS=30
KEDA_COOLDOWN_SECONDS=300

# Live Azure integration tests
RUN_AZURE_INTEGRATION_TESTS=false
